{
    "name": "go-mod-upgrade",
    "id": "go-mod-upgrade",
    "version": "1.0.0",
    "description": "upgrade outdated Go dependencies interactively.",
    "keywords": [
        "go",
        "mod",
        "modules",
        "dependencies"
    ],
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "description": "version of go-mod-upgrade to install"
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/go"
    ]
}